# ==========================================
# My Keeps Backend Environment Variables
# ==========================================

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/my_keeps?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:3000

# ------------------------------------------
# OPTION A: Resend Email Service (Recommended)
# Sign up free at https://resend.com and copy your API Key
# ------------------------------------------
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="My Keeps <onboarding@resend.dev>"

# ------------------------------------------
# OPTION B: Gmail SMTP (Alternate without Resend API)
# Enable 2FA on Google Account -> Create an App Password (16-char code)
# ------------------------------------------
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_SERVICE=gmail
